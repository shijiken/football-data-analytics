POSTGRES_USER=football
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=football
POSTGRES_PORT=5432
LOG_LEVEL=INFO
# Host runs of the dbt transform (contracts/transform.md). The compose service sets its own.
# Export them with `set -a; . ./.env; set +a`.
DBT_PG_HOST=127.0.0.1
DBT_PG_PORT=${POSTGRES_PORT}
DBT_PG_USER=${POSTGRES_USER}
DBT_ENV_SECRET_PG_PASSWORD=${POSTGRES_PASSWORD}
DBT_PG_DBNAME=${POSTGRES_DB}
# Optional: override the commit-pinned dataset URL (research.md R1).
# SOURCE_URL=https://raw.githubusercontent.com/xgabora/Club-Football-Match-Data/25882a58a736daf7ece3781940eac17ae1117a66/data/Matches.csv
